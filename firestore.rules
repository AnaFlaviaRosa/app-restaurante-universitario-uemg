rules_version = '2';

// Regras de segurança do Firestore para o app do RU.
//
// Chave primária do usuário: o uid do Firebase Auth (`usuarios/{uid}`).
// O CPF é só um CAMPO dentro do documento (nunca ID nem parte de regra).
// A unicidade de CPF vem de `cpfs_em_uso/{cpf} = { uid }`.
//
// LIMITAÇÕES CONHECIDAS (não há backend/Cloud Functions no plano gratuito):
//  - O dono ainda pode alterar o próprio `saldoAtual` (recarga simulada,
//    débito da reserva e estorno rodam no app). Dá para "se dar saldo".
//    Só se resolve de verdade movendo essas operações para um servidor.
//  - Prazos (reservar/cancelar) usam o relógio do celular; as regras não
//    conhecem o horário de funcionamento. O que as regras garantem é a
//    HORA DO SERVIDOR na abertura do protocolo e as transições de status.
// Teste estas regras no Emulador do Firebase antes de publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------
    // Funções auxiliares
    // ------------------------------------------------------------

    function estaLogado() {
      return request.auth != null;
    }

    function souDono(uid) {
      return estaLogado() && request.auth.uid == uid;
    }

    function souAdmin() {
      return estaLogado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipo == 'admin';
    }

    // Conta de serviço da catraca (a "ponte"). `catracas/{uid}` só é
    // escrito pelo Console do Firebase: ninguém vira catraca pelo app.
    function souCatraca() {
      return estaLogado() &&
        exists(/databases/$(database)/documents/catracas/$(request.auth.uid));
    }

    // Preço da refeição para um tipo de usuário (config/precos, com os
    // mesmos valores padrão do app se o documento não existir).
    function precoDoTipo(tipo) {
      let precos = exists(/databases/$(database)/documents/config/precos)
        ? get(/databases/$(database)/documents/config/precos).data
        : {};
      return tipo == 'comum'
        ? precos.get('precoComum', 17.0)
        : precos.get('precoEstudante', 4.0);
    }

    // Integração da catraca ligada? (config/catraca.integracaoAtiva)
    function integracaoCatracaAtiva() {
      return exists(/databases/$(database)/documents/config/catraca) &&
        get(/databases/$(database)/documents/config/catraca).data
          .get('integracaoAtiva', false) == true;
    }

    // A matrícula foi marcada como usada POR ESTE uid? (feito no cadastro
    // do estudante, antes de criar `usuarios/{uid}`.)
    function matriculaUsadaPor(matricula, uid) {
      return matricula is string &&
        exists(/databases/$(database)/documents/matriculas_validas/$(matricula)) &&
        get(/databases/$(database)/documents/matriculas_validas/$(matricula)).data.usada == true &&
        get(/databases/$(database)/documents/matriculas_validas/$(matricula)).data
          .get('usadaPor', '') == uid;
    }

    // ------------------------------------------------------------
    // CPFs em uso (checagem de unicidade)
    // ------------------------------------------------------------
    // Cada um só cria a própria entrada; nunca é atualizada/apagada pelo
    // cliente (evita "liberar" o CPF de outra pessoa).
    match /cpfs_em_uso/{cpf} {
      allow read: if estaLogado();
      allow create: if estaLogado() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------
    // Usuários
    // ------------------------------------------------------------
    // - CRIAR: só o próprio uid, como 'comum' ou como 'estudante' (neste
    //   caso a matrícula precisa ter sido marcada por ele), SEMPRE com
    //   saldo 0 e só com os campos esperados. Ninguém vira admin pelo app:
    //   o admin é criado trocando `tipo` no Console do Firebase.
    // - ATUALIZAR: o dono só mexe em nome, e-mail e saldo (não troca tipo,
    //   CPF nem matrícula). Admin mexe em tudo (ex.: estorno de fechamento).
    //   A catraca só pode DIMINUIR o saldo, em até o preço do tipo (cobrança
    //   de quem passou sem reserva).
    // - LER: o dono, o admin e a catraca (a ponte localiza o usuário pela
    //   matrícula/CPF vindo do reconhecimento facial). Proteja a credencial
    //   da catraca: ela enxerga os usuários.
    match /usuarios/{uid} {
      allow read: if souDono(uid) || souAdmin() || souCatraca();

      allow create: if souDono(uid) &&
        request.resource.data.keys()
          .hasOnly(['cpf', 'nome', 'email', 'tipo', 'matricula', 'saldoAtual', 'criadoEm']) &&
        request.resource.data.saldoAtual == 0 &&
        (request.resource.data.tipo == 'comum' ||
         (request.resource.data.tipo == 'estudante' &&
          matriculaUsadaPor(request.resource.data.matricula, uid)));

      allow update: if souAdmin() ||
        (souDono(uid) &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['nome', 'email', 'saldoAtual'])) ||
        (souCatraca() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['saldoAtual']) &&
         resource.data.saldoAtual - request.resource.data.saldoAtual
           >= precoDoTipo(resource.data.tipo) - 0.01 &&
         resource.data.saldoAtual - request.resource.data.saldoAtual
           <= precoDoTipo(resource.data.tipo) + 0.01);
    }

    // ------------------------------------------------------------
    // Reservas
    // ------------------------------------------------------------
    // Ciclo: confirmada -> liberada (catraca) -> utilizada (protocolo
    // aberto ou admin) | naoRetirada (admin) | cancelada.
    //
    // - CRIAR (dono): sempre 'confirmada', com o VALOR igual ao preço do
    //   tipo dele em config/precos e um código de 6 caracteres.
    // - Dono pode: cancelar (confirmada -> cancelada) e ABRIR O PROTOCOLO
    //   (-> utilizada), gravando `protocoloAbertoEm` = hora do SERVIDOR.
    //   Abrir a partir de 'liberada' sempre; a partir de 'confirmada' só se
    //   a integração da catraca estiver DESLIGADA (contingência).
    // - Catraca: só confirmada -> liberada (e `liberadaEm` = hora do servidor).
    // - Admin: tudo (marcar retirada/não retirada, reverter, fechar o RU).
    match /reservas/{reservaId} {
      allow read: if souAdmin() || souCatraca() ||
        (estaLogado() && resource.data.usuarioId == request.auth.uid);

      allow create: if estaLogado() &&
        request.resource.data.usuarioId == request.auth.uid &&
        request.resource.data.status == 'confirmada' &&
        request.resource.data.tipoRefeicao in ['almoco', 'janta'] &&
        request.resource.data.codigo is string &&
        request.resource.data.codigo.size() == 6 &&
        request.resource.data.valor ==
          precoDoTipo(get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.tipo);

      allow update: if souAdmin() ||
        (souCatraca() &&
         resource.data.status == 'confirmada' &&
         request.resource.data.status == 'liberada' &&
         request.resource.data.liberadaEm == request.time &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'liberadaEm'])) ||
        (estaLogado() &&
         resource.data.usuarioId == request.auth.uid &&
         (
           // cancelar
           (resource.data.status == 'confirmada' &&
            request.resource.data.status == 'cancelada' &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status'])) ||
           // abrir o protocolo (uso único)
           (request.resource.data.status == 'utilizada' &&
            request.resource.data.protocoloAbertoEm == request.time &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'protocoloAbertoEm']) &&
            (resource.data.status == 'liberada' ||
             (resource.data.status == 'confirmada' && !integracaoCatracaAtiva())))
         ));

      allow delete: if false;
    }

    // ------------------------------------------------------------
    // Marcador de "reserva ativa" ({uid}_{AAAA-MM-DD}_{refeição})
    // ------------------------------------------------------------
    // Garante 1 reserva por pessoa/dia/refeição (criado e apagado dentro
    // das transações do app).
    // - LER: `resource == null` permite checar um marcador que ainda não
    //   existe (sem isso, a 1ª reserva de cada refeição seria negada).
    // - APAGAR (dono): só junto do cancelamento da reserva correspondente
    //   (`getAfter` olha o estado DEPOIS da mesma transação). Assim o dono
    //   não apaga o marcador por fora para reservar duas vezes.
    match /reservas_ativas/{id} {
      // A catraca lê o marcador para achar a reserva do dia da pessoa que
      // passou (sem precisar de consulta/índice).
      allow read: if souAdmin() || souCatraca() ||
        (estaLogado() &&
         (resource == null || resource.data.usuarioId == request.auth.uid));
      allow create: if estaLogado() &&
        request.resource.data.usuarioId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['usuarioId', 'reservaId']);
      allow delete: if souAdmin() ||
        (estaLogado() &&
         resource.data.usuarioId == request.auth.uid &&
         getAfter(/databases/$(database)/documents/reservas/$(resource.data.reservaId)).data.status == 'cancelada');
      allow update: if false;
    }

    // ------------------------------------------------------------
    // Movimentações financeiras
    // ------------------------------------------------------------
    // Só o dono lê. Criam: o dono (recarga, consumo, estorno do próprio
    // app), o admin (estorno do "RU fechado") e a catraca (consumo de quem
    // passou sem reserva; o ID do documento = ID do evento da catraca, então
    // reenviar o mesmo evento não cobra duas vezes). Ninguém edita/apaga.
    match /movimentacoes/{id} {
      allow read: if souAdmin() ||
        (estaLogado() && resource.data.usuarioId == request.auth.uid);
      allow create: if souAdmin() ||
        (estaLogado() && request.resource.data.usuarioId == request.auth.uid) ||
        (souCatraca() &&
         request.resource.data.tipo == 'consumo' &&
         request.resource.data.status == 'aprovada');
      allow update, delete: if false;
    }

    // ------------------------------------------------------------
    // Matrículas válidas
    // ------------------------------------------------------------
    // - LER UMA matrícula (`get`): qualquer logado (o cadastro precisa).
    // - LISTAR todas: só o admin (evita qualquer usuário enumerar matrículas).
    // - MARCAR como usada: quem está se cadastrando, gravando o próprio
    //   uid em `usadaPor`.
    // - DESFAZER (cadastro falhou no meio): só quem a marcou.
    match /matriculas_validas/{matricula} {
      allow get: if estaLogado();
      allow list: if souAdmin();
      allow create, delete: if souAdmin();
      allow update: if souAdmin() ||
        (estaLogado() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['usada', 'usadaEm', 'usadaPor']) &&
         (
           (resource.data.usada == false &&
            request.resource.data.usada == true &&
            request.resource.data.usadaPor == request.auth.uid) ||
           (resource.data.usada == true &&
            resource.data.get('usadaPor', '') == request.auth.uid &&
            request.resource.data.usada == false)
         ));
    }

    // ------------------------------------------------------------
    // Disponibilidade de marmitas
    // ------------------------------------------------------------
    // Logados leem; admin define a quantidade livremente. Usuário comum
    // só muda `quantidadeDisponivel` em exatamente 1 por chamada (reserva
    // ou cancelamento), dentro de 0..quantidadeTotal.
    // (Ideal a longo prazo: Cloud Function, que exige plano Blaze.)
    match /disponibilidades/{id} {
      allow read: if estaLogado();
      allow create: if souAdmin();
      allow update: if souAdmin() ||
        (estaLogado() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['quantidadeDisponivel']) &&
         (resource.data.quantidadeDisponivel -
            request.resource.data.quantidadeDisponivel == 1 ||
          request.resource.data.quantidadeDisponivel -
            resource.data.quantidadeDisponivel == 1) &&
         request.resource.data.quantidadeDisponivel >= 0 &&
         request.resource.data.quantidadeDisponivel <=
           resource.data.quantidadeTotal);
      allow delete: if souAdmin();
    }

    // ------------------------------------------------------------
    // Cardápio, lotação, configurações e avisos
    // ------------------------------------------------------------
    match /cardapios/{id} {
      allow read: if estaLogado();
      allow write: if souAdmin();
    }

    match /lotacao/{id} {
      allow read: if estaLogado();
      allow write: if souAdmin();
    }

    // Horários, preços, config/catraca (integração ligada?) e
    // config/status (RU fechado hoje): leitura para logados; só admin edita.
    match /config/{id} {
      allow read: if estaLogado();
      allow write: if souAdmin();
    }

    // Quadro de avisos: leitura para logados; só admin publica/apaga.
    match /avisos/{id} {
      allow read: if estaLogado();
      allow write: if souAdmin();
    }

    // ------------------------------------------------------------
    // Passagens (refeição no local) — usado só pela ponte da catraca
    // ------------------------------------------------------------
    // `passagens/{uid}_{AAAA-MM-DD}_{refeição}` marca que a pessoa já foi
    // cobrada naquela refeição: uma 2ª passagem não cobra de novo. Criado
    // no mesmo commit da cobrança; só a catraca cria; ninguém edita.
    match /passagens/{id} {
      allow read: if souCatraca() || souAdmin();
      allow create: if souCatraca() &&
        request.resource.data.keys().hasOnly(['uid', 'eventoId', 'expireAt']);
      allow update: if false;
      allow delete: if souAdmin();
    }

    // ------------------------------------------------------------
    // Catraca
    // ------------------------------------------------------------
    // `catracas/{uid}`: só o Console escreve; o cliente nunca lê.
    match /catracas/{uid} {
      allow read: if false;
      allow write: if false;
    }

    // Eventos de ENTRADA no restaurante (lotação): { ts, tipo, origem,
    // expireAt }. Sem dado pessoal. A ponte só grava aqui quem vai COMER
    // NO LOCAL; quem retira marmita (tem reserva) NÃO entra neste log, para
    // não inflar a estimativa de pessoas dentro. Catraca ou admin criam com
    // horário dentro de 2 min do servidor; só admin, só para SIMULAÇÃO,
    // pode usar horários das últimas 3 h. Nunca edita; só admin apaga.
    match /lotacao_eventos/{id} {
      allow read: if estaLogado();
      allow create: if
        request.resource.data.keys().hasOnly(['ts', 'tipo', 'origem', 'expireAt']) &&
        request.resource.data.tipo == 'entrada' &&
        request.resource.data.ts is timestamp &&
        request.resource.data.ts <= request.time + duration.value(1, 'm') && (
          ((souCatraca() || souAdmin()) &&
           request.resource.data.ts > request.time - duration.value(2, 'm')) ||
          (souAdmin() && request.resource.data.origem == 'simulacao' &&
           request.resource.data.ts > request.time - duration.value(3, 'h'))
        );
      allow update: if false;
      allow delete: if souAdmin();
    }
  }
}
